# X / Twitter read-only trends — never commit real secrets.
# Create apps/web/.env.local (gitignored) with real values.

# App-only Bearer for Twitter API v1.1 GET trends/place (WOEID 1).
TWITTER_BEARER_TOKEN=

# Optional RapidAPI fallback — host like twitter-api45.p.rapidapi.com (example only).
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=

# --- Google OAuth (NextAuth v5) ---
# Generate AUTH_SECRET: npx auth secret
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required in production only (auto-detected in dev)
# NEXTAUTH_URL=https://yourdomain.com
