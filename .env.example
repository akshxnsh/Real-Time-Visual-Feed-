GNEWS_API_KEY=your_gnews_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Separate Groq key for homepage trending topic generation (falls back to GROQ_API_KEY if unset)
GROQ_TRENDS_API_KEY=your_groq_trends_api_key_here
NEXT_PUBLIC_API_URL=http://localhost:3001

# io.net API key — must have io-cloud project scopes for Agent Cloud MCP
IO_NET_API_KEY=your_io_net_api_key_here

# Docker images for the rtvf Video Server (push to Docker Hub first)
IO_NET_CONTAINER_IMAGE_US=your-dockerhub-user/rtvf-video-server:latest
IO_NET_CONTAINER_IMAGE_IN=your-dockerhub-user/rtvf-video-server:latest

# Optional GPU type override per region (default: RTX4090)
# IO_NET_GPU_TYPE_US=RTX4090
# IO_NET_GPU_TYPE_IN=RTX4090

# Optional static fallback endpoints (used if MCP agent is disabled or during cold start)
# IO_NET_ENDPOINT_US=https://your-us-node-url/
# IO_NET_ENDPOINT_IN=https://your-in-node-url/

NEWSDATA_API_KEY=your_newsdata_api_key_here

# Supabase Storage (S3-compatible) — used by the Python video server to store generated videos
# Keys: Supabase Dashboard → Project Settings → Storage → S3 Connection (Pro+ plan)
STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_ACCESS_KEY=your_supabase_s3_access_key
STORAGE_SECRET_KEY=your_supabase_s3_secret_key
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=your_bucket_name
SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co

# Google OAuth (Next-Auth v5)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=your_auth_secret_here
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
